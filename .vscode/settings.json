{
  // This repo holds two independent packages (backend/, frontend/) and has no config at
  // the root. Without "auto", the editor lints files from the repo root, builds the wrong
  // TypeScript program, and reports phantom errors — typically rules like
  // @typescript-eslint/no-unsafe-return firing on values it typed as `error` because it
  // could not resolve an import. "auto" makes each file use its own package as cwd.
  "eslint.workingDirectories": [{ "mode": "auto" }],
  "eslint.useFlatConfig": true,
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],

  // Prettier owns formatting in both packages; ESLint only fixes lint rules.
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },

  // pnpm symlinks its store, so file watching must follow node_modules links but never
  // index them — indexing the store makes search and the TS server crawl.
  "search.exclude": {
    "**/node_modules": true,
    "**/pnpm-lock.yaml": true,
    "backend/dist": true
  },
  "files.watcherExclude": {
    "**/node_modules/.pnpm/**": true
  },

  "typescript.tsserver.watchOptions": {
    "watchFile": "useFsEvents",
    "watchDirectory": "useFsEvents"
  },
  "typescript.enablePromptUseWorkspaceTsdk": true
}
